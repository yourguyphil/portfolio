# Canonical URL of the deployed site (used for metadata / OG tags).
NEXT_PUBLIC_SITE_URL=https://philipsnguyen.com

# Plausible analytics. Analytics is disabled unless the domain is set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: override the script URL (self-hosted Plausible or a site-specific script).
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.outbound-links.tagged-events.js

# Optional: Formspree endpoint for the contact form.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/philips.nguyen@veym.net
